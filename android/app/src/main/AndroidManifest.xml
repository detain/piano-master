<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone capture for the audio engine (plan §20 P0.2.1). Declared
         now so the engine bridge can request it; the runtime permission
         request UI lands with the first screen that starts the mic. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeyQuest">
        <!-- TODO(design): launcher icon (@mipmap/ic_launcher) lands with the design pass;
             android:icon is omitted so v1 stays lint-clean without binary assets. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>